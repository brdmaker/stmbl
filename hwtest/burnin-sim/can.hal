# hwtest/burnin-sim over CAN (docs/can_support.md): in place of
# stmbl_sim.hal. The simulated drive links "can" (conf/template/can.txt)
# and sits on a simulated bus with a simulated MCP2515 (stmbl_sim can=1);
# LinuxCNC's end is the real stmblcan component (spi=sim), as on the Pi
# with spi=/dev/spidev0.0. stmblcan asks the drive for its description at
# load (discover=1). The console goes over CAN too: sserialterm on the
# node's con pins, a pty at [SSERIALTERM]TTY.
#
# Servo thread: stmblcan.read first (last period's feedback), stmblcan.write
# last (commands, SYNC), then the simulated drive and bus for the period.
loadrt [KINS]KINEMATICS
loadrt [EMCMOT]EMCMOT servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS
loadrt stmbl_sim conf=[STMBL_SIM]CONF sim=[STMBL_SIM]SIM tty=[STMBL_SIM]TTY can=1
loadrt stmblcan spi=sim nodes=1 discover=1
loadrt sserialterm tty=[SSERIALTERM]TTY

addf stmblcan.read                        servo-thread
addf motion-command-handler               servo-thread
addf motion-controller                    servo-thread
addf sserialterm.0                        servo-thread
addf stmblcan.write                       servo-thread
addf stmbl-sim.0                          servo-thread

net xposcmd joint.0.motor-pos-cmd  => stmblcan.0.1.pos-cmd
net xvelcmd joint.0.vel-cmd        => stmblcan.0.1.vel-cmd
net xposfb  joint.0.motor-pos-fb  <=  stmblcan.0.1.pos-fb
net xenable joint.0.amp-enable-out => stmblcan.0.1.enable
net xfault  joint.0.amp-fault-in  <=  stmblcan.0.1.fault
# index homing: stmblcan clears index-enable once the drive found the index
net xindex  joint.0.index-enable  <=> stmblcan.0.1.index-enable

net drive0-con-fb  stmblcan.0.1.con-fb   => sserialterm.0.con-fb
net drive0-con-cmd sserialterm.0.con-cmd => stmblcan.0.1.con-cmd

net estop-loop iocontrol.0.user-enable-out => iocontrol.0.emc-enable-in
net tool-prep-loop iocontrol.0.tool-prepare => iocontrol.0.tool-prepared
net tool-change-loop iocontrol.0.tool-change => iocontrol.0.tool-changed
