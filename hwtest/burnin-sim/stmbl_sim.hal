# hwtest/burnin-sim: ../burnin/stmbl.hal with the drive simulated.
# stmbl_sim runs the drive firmware's control code and a motor model in
# the servo thread; its pins match hm2_7c81.0.stbl.0.0.* of a real drive.
loadrt [KINS]KINEMATICS
loadrt [EMCMOT]EMCMOT servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS
loadrt stmbl_sim conf=[STMBL_SIM]CONF sim=[STMBL_SIM]SIM tty=[STMBL_SIM]TTY

addf stmbl-sim.0                          servo-thread
addf motion-command-handler               servo-thread
addf motion-controller                    servo-thread

net xposcmd joint.0.motor-pos-cmd  => stmbl-sim.0.pos_cmd
net xvelcmd joint.0.vel-cmd        => stmbl-sim.0.vel_cmd
net xposfb  joint.0.motor-pos-fb  <=  stmbl-sim.0.pos_fb
net xenable joint.0.amp-enable-out => stmbl-sim.0.enable
net xfault  joint.0.amp-fault-in  <=  stmbl-sim.0.fault
#net xindex  joint.0.index-enable  <=> stmbl-sim.0.index_enable

# No hostmot2 watchdog to latch: estop follows the GUI.
net estop-loop iocontrol.0.user-enable-out => iocontrol.0.emc-enable-in

# create signals for tool loading loopback
net tool-prep-loop iocontrol.0.tool-prepare => iocontrol.0.tool-prepared
net tool-change-loop iocontrol.0.tool-change => iocontrol.0.tool-changed
