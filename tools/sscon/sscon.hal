# The drive's console over smart-serial, nothing else: the Mesa driver and
# linuxcnc/sserialterm on a 1 ms thread, for servoterm-cli (and the setup
# wizard) without LinuxCNC. tools/sscon/sscon.sh starts it. The drive's
# config must load sserial (the wizard's console.sserial = 1 does).
# Driver settings as hwtest/burnin/stmbl.ini [HOSTMOT2].
loadrt threads name1=servo-thread period1=1000000
loadrt hostmot2
loadrt hm2_spix config=" sserial_port_0=00000000" spiclk_rate=25000 spiclk_rate_rd=25000
loadrt sserialterm tty=[SSCON]TTY
addf hm2_7c81.0.read  servo-thread
addf sserialterm.0    servo-thread
addf hm2_7c81.0.write servo-thread
setp hm2_7c81.0.watchdog.timeout_ns 50000000
# flashsaveconf stops the drive's rt (and its smart-serial) for the erase,
# up to 0.5 s: ride through 2 s of errors instead of stopping the port
# after 20 (fault-inc 10 a bad frame, -1 a good one)
setp hm2_7c81.0.sserial.port-0.fault-lim 20000
net con-fb  hm2_7c81.0.stbl.0.0.con_fb => sserialterm.0.con-fb
net con-cmd sserialterm.0.con-cmd => hm2_7c81.0.stbl.0.0.con_cmd
start
