# webui/mill/bench: the console's gantry mill on the bench: X is the real
# stmbl drive (hostmot2 smart-serial, as hwtest/burnin), Y, Y2 and Z are
# simulated (their commands loop back as feedback, as test/sim). The
# simulated probe touches the stock (the 3D setup's workpieces) and the tool
# setter (machineconf.sim_probe_hal; millweb keeps it set); the tool changer
# and the spindle answer at once.
loadrt [KINS]KINEMATICS
loadrt [EMCMOT]EMCMOT servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS
loadrt hostmot2
loadrt [HOSTMOT2](DRIVER) config=[HOSTMOT2](CONFIG) [HOSTMOT2](DRIVER_PARAMS)
loadrt estop_latch
# the drive's console over smart-serial for the Drives tab (DRIVE_LINK)
loadrt sserialterm tty=[SSERIALTERM]TTY
# phasing-settled: phasing_ferror.hal's (uspace loads a module once)
loadrt and2 names=phasing-settled
# home switches for the simulated joints (they move to them when homing)
loadrt sim_home_switch names=y1home,y2home,zhome

setp hm2_[HOSTMOT2](BOARD).0.watchdog.timeout_ns 50000000

addf hm2_[HOSTMOT2](BOARD).0.read  servo-thread
addf motion-command-handler        servo-thread
addf motion-controller             servo-thread
addf hm2_[HOSTMOT2](BOARD).0.write servo-thread
addf estop-latch.0                 servo-thread
addf sserialterm.0                 servo-thread
addf y1home                        servo-thread
addf y2home                        servo-thread
addf zhome                         servo-thread

# X: the real drive
net xposcmd joint.0.motor-pos-cmd  => hm2_[HOSTMOT2](BOARD).0.stbl.0.0.pos_cmd
net xvelcmd joint.0.vel-cmd        => hm2_[HOSTMOT2](BOARD).0.stbl.0.0.vel_cmd
net xposfb  joint.0.motor-pos-fb  <=  hm2_[HOSTMOT2](BOARD).0.stbl.0.0.pos_fb
net xenable joint.0.amp-enable-out => hm2_[HOSTMOT2](BOARD).0.stbl.0.0.enable
net xfault  joint.0.amp-fault-in  <=  hm2_[HOSTMOT2](BOARD).0.stbl.0.0.fault
net xcon-fb  hm2_[HOSTMOT2](BOARD).0.stbl.0.0.con_fb => sserialterm.0.con-fb
net xcon-cmd sserialterm.0.con-cmd => hm2_[HOSTMOT2](BOARD).0.stbl.0.0.con_cmd
# homing: X creeps to the encoder's index (HOME_USE_INDEX, the drive's idx_home)
net xindex  joint.0.index-enable  <=> hm2_[HOSTMOT2](BOARD).0.stbl.0.0.index_enable

# Y, Y2, Z: simulated
net j1 joint.1.motor-pos-cmd => joint.1.motor-pos-fb y1home.cur-pos
net j2 joint.2.motor-pos-cmd => joint.2.motor-pos-fb y2home.cur-pos
net j3 joint.3.motor-pos-cmd => joint.3.motor-pos-fb zhome.cur-pos
# the switches, in the joints' raw positions (0 at start-up): Y1/Y2 50 mm
# and Z 20 mm away in the search direction ([JOINT_n]HOME_* in mill.ini)
setp y1home.home-pos 50
setp y2home.home-pos 50
setp zhome.home-pos 20
net y1home-sw y1home.home-sw => joint.1.home-sw-in
net y2home-sw y2home.home-sw => joint.2.home-sw-in
net zhome-sw  zhome.home-sw  => joint.3.home-sw-in

# a simulated probe: the stock's top and the tool setter, in machine coordinates, during probe moves (millweb sets the stock and the tool length)
loadrt sum2 names=probe-tip
loadrt wcomp names=probe-sx,probe-sy,probe-sz,probe-tx,probe-ty,probe-tz,probe-moving
loadrt conv_s32_float names=probe-mtype
loadrt logic names=probe-stock,probe-setter,probe-any personality=0x104,0x104,0x202
net probe-x joint.0.pos-fb => probe-sx.in probe-tx.in
net probe-y joint.1.pos-fb => probe-sy.in probe-ty.in
net probe-z joint.3.pos-fb => probe-tip.in0
setp probe-tip.gain1 -1
setp probe-tip.in1 0
net probe-tip probe-tip.out => probe-sz.in probe-tz.in
setp probe-sx.min -301
setp probe-sx.max 301
setp probe-sy.min -1
setp probe-sy.max 1001
setp probe-sz.min -100000
setp probe-sz.max -195
setp probe-tx.min 240
setp probe-tx.max 260
setp probe-ty.min 10
setp probe-ty.max 30
setp probe-tz.min -100000
setp probe-tz.max -245
net probe-mtype-s motion.motion-type => probe-mtype.in
net probe-mtype-f probe-mtype.out => probe-moving.in
setp probe-moving.min 4.5
setp probe-moving.max 5.5
net probe-in-sx probe-sx.out => probe-stock.in-00
net probe-in-sy probe-sy.out => probe-stock.in-01
net probe-in-sz probe-sz.out => probe-stock.in-02
net probe-in-tx probe-tx.out => probe-setter.in-00
net probe-in-ty probe-ty.out => probe-setter.in-01
net probe-in-tz probe-tz.out => probe-setter.in-02
net probe-moving probe-moving.out => probe-stock.in-03 probe-setter.in-03
net probe-on-stock probe-stock.and => probe-any.in-00
net probe-on-setter probe-setter.and => probe-any.in-01
net probe probe-any.or => motion.probe-input
addf probe-tip servo-thread
addf probe-mtype servo-thread
addf probe-moving servo-thread
addf probe-sx servo-thread
addf probe-sy servo-thread
addf probe-sz servo-thread
addf probe-tx servo-thread
addf probe-ty servo-thread
addf probe-tz servo-thread
addf probe-stock servo-thread
addf probe-setter servo-thread
addf probe-any servo-thread

# E-stop: the card's watchdog latches it
net user-enable iocontrol.0.user-request-enable => estop-latch.0.reset
net enable-latch estop-latch.0.ok-out => iocontrol.0.emc-enable-in
net watchdog hm2_[HOSTMOT2](BOARD).0.watchdog.has_bit => estop-latch.0.fault-in

net tool-change iocontrol.0.tool-change => iocontrol.0.tool-changed
net tool-prep iocontrol.0.tool-prepare => iocontrol.0.tool-prepared
setp spindle.0.at-speed 1
