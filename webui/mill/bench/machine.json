{
  "version": 1,
  "name": "PORTAL-M bench (X real)",
  "units": "mm",
  "servo_period_ns": 1000000,
  "board": {"type": "hm2_spix", "name": "7c81", "params": "spiclk_rate=25000 spiclk_rate_rd=25000",
            "config": " sserial_port_0=00000000", "watchdog_ms": 50},
  "bitstream": {"loader": "none"},
  "axes": {
    "X": {"min": -300, "max": 300, "max_vel": 500, "max_acc": 1000},
    "Y": {"min": 0, "max": 1000, "max_vel": 500, "max_acc": 3000},
    "Z": {"min": -215, "max": 0, "max_vel": 200, "max_acc": 2000}
  },
  "joints": [
    {"axis": "X", "drive": {"type": "stmbl_sserial", "port": 0, "channel": 0}, "ferror": 1, "min_ferror": 1,
     "phasing_ferror": 2, "phasing_time": 1.5,
     "min": -301, "max": 301, "max_vel": 500, "max_acc": 1000,
     "home": {"method": "index", "pos": 0, "sequence": 2, "latch_vel": 3, "offset": 0}},
    {"axis": "Y", "drive": {"type": "sim"}, "ferror": 2, "min_ferror": 0.5,
     "home": {"method": "switch", "switch": "sim", "sim_at": "random", "search_vel": 50, "latch_vel": 5, "offset": 1000, "pos": 990, "sequence": 1}},
    {"axis": "Y", "drive": {"type": "sim"}, "ferror": 2, "min_ferror": 0.5,
     "home": {"method": "switch", "switch": "sim", "sim_at": "random", "search_vel": 50, "latch_vel": 5, "offset": 1000, "pos": 990, "sequence": 1}},
    {"axis": "Z", "drive": {"type": "sim"}, "ferror": 2, "min_ferror": 0.5,
     "home": {"method": "switch", "switch": "sim", "sim_at": "random", "search_vel": 20, "latch_vel": 2, "offset": 0, "pos": -5, "sequence": 0}}
  ],
  "estop": {"input": ""},
  "probe": {"type": "sim", "sim_z": -195},
  "spindle": {"type": "sim", "max_rpm": 24000},
  "toolsetter": {"x": 250, "y": 20, "z_above": -40, "z_ref": -245, "travel": 200},
  "display": {"max_feed_override": 2.0, "max_spindle_override": 1.5, "min_spindle_override": 0.5},
  "console": {"port": 8080, "host": "0.0.0.0", "cpus": "0-1",
              "pins": ["joint.0.f-error", "hm2_7c81.0.stbl.0.0.vel_fb", "joint.1.f-error", "joint.3.motor-pos-fb", "motion.probe-input", "spindle.0.speed-out"],
              "extra": {"POLL_HZ": 30, "WORKSPACE_X": "-100 100", "WORKSPACE_Y": "400 600", "WORKSPACE_Z": "-195 0"}}
}
