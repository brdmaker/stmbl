#!/usr/bin/env python3
# millweb-supervisor: LinuxCNC for a machine folder (machine.json), again and
# again, with millweb as its display; the console stays up while LinuxCNC
# restarts (server/supervisor.py). Run it in LinuxCNC's environment, as the
# machine's user (a systemd service: webui/mill/README.md).
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "server"))
import supervisor  # noqa: E402

sys.exit(supervisor.main())
