# Mikron HSM 400U retrofit (hsm400u.mill), full-closed loop: the glass
# scales on X Y Z (0.1 um) close the position loops, the velocity loops stay
# on the motors' EnDat (hsm400u/scale.conf). Estimates throughout.
include hsm400u/frame.inc
drive x hsm400u/1fk6.conf,hsm400u/x.conf,hsm400u/scale.conf hsm400u/sim.txt 16
drive y hsm400u/1fk6.conf,hsm400u/y.conf,hsm400u/scale.conf hsm400u/sim.txt 16
drive z hsm400u/1fk6.conf,hsm400u/z.conf,hsm400u/scale.conf hsm400u/sim.txt 16
drive a hsm400u/1fk6.conf,hsm400u/a.conf hsm400u/sim.txt 3
drive c hsm400u/1fk6.conf,hsm400u/c.conf hsm400u/sim.txt 4.5
brake z
rnoise x 0.5
rnoise y 0.5
rnoise z 0.5
rnoise a 0.5
rnoise c 0.5
scale x 0.1 0.02
scale y 0.1 0.02
scale z 0.1 0.02
