# PID control-logic demo for the sys_id bandwidth-based pid (post-merge).
# Cascade: pos_error -> vel_cmd (pos_bw) -> acc_cmd (vel_bw) -> torque.
load pid
pid0.rt_prio = 1
pid0.en = 1

# limits (else the cascade clamps to zero)
pid0.max_vel        = 1000
pid0.neg_min_vel    = 1000
pid0.max_acc        = 1000000
pid0.max_torque     = 1000
pid0.neg_min_torque = 1000
pid0.j_mot          = 0.001
pid0.vel_g          = 1
# defaults from nrt_init: pos_bw=100, vel_bw=2000, vel_d=2, torque_g=1
start

# commanded position 1.0 rad, feedback at 0 -> error = 1.0 rad
pid0.pos_ext_cmd = 1.0
pid0.pos_fb = 0.0
step 1
pid0.pos_error        # expect 1.0
pid0.vel_cmd          # expect pos_error*pos_bw = 100
pid0.acc_cmd          # expect vel_error*vel_bw = 200000
pid0.fb_torque_cmd    # acc*j_mot + integral = 200 + 40 = 240
pid0.torque_cmd       # expect 240

# feedback reaches target -> error collapses
pid0.pos_fb = 1.0
step 1
pid0.pos_error        # ~0
pid0.vel_cmd          # ~0
