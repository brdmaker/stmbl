# GENERATED by tests/gen_motor_tests.py -- edit the table there.
# rlpsij autotune on motor ecma_c30604fs: r 2.1517, l 0.022957, psi 0.047433,
# polecount 5, j 4.4e-05, test_cur 3.0 (30% of max_ac_cur 10).
@args --drive ../hwtest/burnin/ECMA-C30604FS/stmbl.conf
conf0.r = 2.1517
conf0.l = 0.022957
conf0.psi = 0.047433
conf0.polecount = 5
conf0.j = 4.4e-05
conf0.f = 0.0711
conf0.d = 0.0001
conf0.max_ac_cur = 10
@include tests/inc/rlpsij_hv0.txt
rlpsij0.test_cur = 3.0
rlpsij0.abs_pos_fb = hv0.sim_pos
# j and l x 1e6, so the 6-decimal console keeps their digits
load scale
load scale
scale0.rt_prio = 15
scale0.scale = 1000000
scale0.in0 = rlpsij0.j
scale1.rt_prio = 15
scale1.scale = 1000000
scale1.in0 = rlpsij0.l
relink
start
debug_level 0
fault0.cmd_error = 0
rlpsij0.en = 1
@sample hv0.sim_vel 0.002 18
rlpsij0.state
rlpsij0.r
rlpsij0.psi
rlpsij0.polecount
rlpsij0.friction
rlpsij0.damping
rlpsij0.load
scale0.out0
scale1.out0
@expect rlpsij0.state == 6
@expect rlpsij0.r ~ 2.1517 3%
@expect rlpsij0.polecount == 5
@expect rlpsij0.psi ~ 0.047433 5%
@expect scale0.out0 ~ 44.0 10%
@expect rlpsij0.friction ~ 0.0711 15%
@expect scale1.out0 ~ 22957 10%
@expect max|hv0.sim_vel| < 80
