# Emergency braking (docs/emergency_stop.md) on the burn-in axis (10 mm a
# revolution): at 188 rad/s (300 mm/s) something fails; hv0.sim_dist,
# zeroed then, is how far the axis went (1 rad = 1.59 mm). Coasting takes
# ~16 rad (26 mm) and ~180 ms.
# estop_link.test over CAN (docs/can_support.md): the drive taken off the
# bus (canplug 0); can0 times out, drops enable, flags CMD error: the same
# quick stop.
@args --drive tests/can/stmbl.conf
@timeout 120
can0.vel_scale = 600
lcnccan 1 600
lcnc 0 0
run 0.5
lcnc 1 0
run 1.5
lcnc 1 300
run 1
hv0.sim_vel
hv0.sim_dist = 0
canplug 0
run 0.012
fault0.stop
run 0.3
hv0.sim_dist
hv0.sim_vel
fault0.fault
fault0.en_out
@expect hv0.sim_vel[1] ~ 188.5 1%
@expect fault0.stop[1] == 1
@expect hv0.sim_dist ~ 2.2 0.6
@expect hv0.sim_vel[2] ~ 0 0.5
@expect fault0.fault == 1
@expect fault0.en_out == 0
