lcncstop
@sample hv0.sim_vbus 0.001 0.1
run 0.5
hv0.sim_vel
hv0.sim_hv_fault
fault0.stop
fault0.en_out
@expect hv0.sim_hv_fault == 11
@expect fault0.stop == 0
@expect fault0.en_out == 0
@expect max hv0.sim_vbus > 410
@expect max hv0.sim_vbus < 440
@expect hv0.sim_vel > 250
