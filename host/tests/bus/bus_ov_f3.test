# DC bus (host/hw/hv.c): 230 V 50 Hz mains rectified into the drive's own
# 540 uF, no capacitors on the supply. Motor syn_spindle (j 0.02, 40 A,
# 14.4 Nm), ramped to 288 rad/s: 829 J in the rotor; 540 uF hold ~20 J
# between 323 V and 410 V.
# Without a brake chopper, and with fault0's own limits raised out of the
# way (conf0.high_dc_volt / max_dc_volt 480 / 500 V): the HV board's own
# cut-off. The F3 measures the bus (io.c, filtered ~1.3 ms) and switches
# its bridge off with HV_VOLT_ERROR above ABS_MAX_VOLT (410 V); fault0
# takes that as an HV fault: no stop, coasting (fault0.fault stays CMD_ERROR,
# the link's; the F3 clears its own fault when disabled, as io.c does, so
# hv0.sim_hv_fault keeps it for the test). The bus still overshoots
# (the filter): the F3's limit is the last line, not a brake.
@args --drive ../hwtest/burnin/ECMA-C30604FS/stmbl.conf
@timeout 240
conf0.r = 0.15
conf0.l = 0.002
conf0.psi = 0.12
conf0.polecount = 2
conf0.j = 0.02
conf0.f = 0.288
conf0.d = 0.000403
conf0.max_ac_cur = 40
conf0.max_force = 14.4
conf0.max_vel = 320.0
conf0.cur_ind = 1
conf0.high_dc_volt = 480
conf0.max_dc_volt = 500
# id_pid result (soak_syn_spindle)
conf0.pos_bw = 32.1648
conf0.vel_bw = 500
conf0.vel_d = 4.1381
hv0.sim_chop_r = 0
debug_level 0
lcnc 0 0
run 0.5
# probe autophasing (fb_switch phase_mode 1) of this heavy rotor: ~2.4 s at
# 10 A (4.3 s at the bench drive's 1 A); the ramp starts once it is done
conf0.phase_cur = 10
lcnc 1 0
run 3.0
lcnc 1 0.91673
