# GENERATED by tests/gen_motor_tests.py -- edit the table there.
# rlpsij autotune on motor e240: r 1.4, l 0.0013, psi 0.2,
# polecount 1, j 2.68e-05, test_cur 3.9 (30% of max_ac_cur 13).
@args --drive ../hwtest/burnin/ECMA-C30604FS/stmbl.conf
conf0.r = 1.4
conf0.l = 0.0013
conf0.psi = 0.2
conf0.polecount = 1
conf0.j = 2.68e-05
conf0.f = 0.078
conf0.d = 0.000109
conf0.max_ac_cur = 13
@include tests/inc/rlpsij_hv0.txt
rlpsij0.test_cur = 3.9
rlpsij0.abs_pos_fb = hv0.sim_pos
# j and l x 1e6, so the 6-decimal console keeps their digits
load scale
load scale
scale0.rt_prio = 15
scale0.scale = 1000000
scale0.in0 = rlpsij0.j
scale1.rt_prio = 15
scale1.scale = 1000000
scale1.in0 = rlpsij0.l
relink
start
debug_level 0
fault0.cmd_error = 0
rlpsij0.en = 1
@sample hv0.sim_vel 0.002 15
rlpsij0.state
rlpsij0.r
rlpsij0.psi
rlpsij0.polecount
rlpsij0.friction
rlpsij0.damping
rlpsij0.load
scale0.out0
scale1.out0
@expect rlpsij0.state == 6
@expect rlpsij0.r ~ 1.4 3%
@expect rlpsij0.polecount == 1
@expect rlpsij0.psi ~ 0.2 5%
@expect scale0.out0 ~ 26.8 10%
@expect rlpsij0.friction ~ 0.078 15%
@expect scale1.out0 ~ 1300 10%
@expect max|hv0.sim_vel| < 80
