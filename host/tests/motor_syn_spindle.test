# GENERATED by tests/gen_motor_tests.py -- edit the table there.
# rlpsij autotune on motor syn_spindle: r 0.15, l 0.002, psi 0.12,
# polecount 2, j 0.02, test_cur 12.0 (30% of max_ac_cur 40).
@args --drive ../hwtest/burnin/ECMA-C30604FS/stmbl.conf
conf0.r = 0.15
conf0.l = 0.002
conf0.psi = 0.12
conf0.polecount = 2
conf0.j = 0.02
conf0.f = 0.288
conf0.d = 0.000403
conf0.max_ac_cur = 40
@include tests/inc/rlpsij_hv0.txt
rlpsij0.test_cur = 12.0
rlpsij0.abs_pos_fb = hv0.sim_pos
# j and l x 1e6, so the 6-decimal console keeps their digits
load scale
load scale
scale0.rt_prio = 15
scale0.scale = 1000000
scale0.in0 = rlpsij0.j
scale1.rt_prio = 15
scale1.scale = 1000000
scale1.in0 = rlpsij0.l
relink
start
debug_level 0
fault0.cmd_error = 0
rlpsij0.en = 1
@sample hv0.sim_vel 0.002 16
rlpsij0.state
rlpsij0.r
rlpsij0.psi
rlpsij0.polecount
rlpsij0.friction
rlpsij0.damping
rlpsij0.load
scale0.out0
scale1.out0
@expect rlpsij0.state == 6
@expect rlpsij0.r ~ 0.15 3%
@expect rlpsij0.polecount == 2
@expect rlpsij0.psi ~ 0.12 5%
@expect scale0.out0 ~ 20000.0 10%
@expect rlpsij0.friction ~ 0.288 15%
@expect scale1.out0 ~ 2000 10%
@expect max|hv0.sim_vel| < 80
