# GENERATED by tests/gen_motor_tests.py -- edit the table there.
# rlpsij autotune on motor sr60_1: r 2.45, l 0.001, psi 0.0621,
# polecount 4, j 3.9e-05, test_cur 3.3 (30% of max_ac_cur 11).
@args --drive ../hwtest/burnin/ECMA-C30604FS/stmbl.conf
conf0.r = 2.45
conf0.l = 0.001
conf0.psi = 0.0621
conf0.polecount = 4
conf0.j = 3.9e-05
conf0.f = 0.082
conf0.d = 0.000115
conf0.max_ac_cur = 11
@include tests/inc/rlpsij_hv0.txt
rlpsij0.test_cur = 3.3
rlpsij0.abs_pos_fb = hv0.sim_pos
# j and l x 1e6, so the 6-decimal console keeps their digits
load scale
load scale
scale0.rt_prio = 15
scale0.scale = 1000000
scale0.in0 = rlpsij0.j
scale1.rt_prio = 15
scale1.scale = 1000000
scale1.in0 = rlpsij0.l
relink
start
debug_level 0
fault0.cmd_error = 0
rlpsij0.en = 1
@sample hv0.sim_vel 0.002 18
rlpsij0.state
rlpsij0.r
rlpsij0.psi
rlpsij0.polecount
rlpsij0.friction
rlpsij0.damping
rlpsij0.load
scale0.out0
scale1.out0
@expect rlpsij0.state == 6
@expect rlpsij0.r ~ 2.45 3%
@expect rlpsij0.polecount == 4
@expect rlpsij0.psi ~ 0.0621 5%
@expect scale0.out0 ~ 39.0 10%
@expect rlpsij0.friction ~ 0.082 15%
# l not checked: l / r = 408 us < 500 us
@expect max|hv0.sim_vel| < 80
