# vel_int0.mode 1 (the acceleration feedforward) and lost LinuxCNC updates:
# the step after a lost one spans two periods; taken as one (sync 0) it is
# twice the speed and a spike of acceleration, 0.48 rad of following error
# at 100 rad/s with 5 % lost and no jitter. sync 1 counts the periods on
# LinuxCNC's grid: 0.0013 (DEBUGNOTES 2026-11-12).
@args --drive ../hwtest/burnin/ECMA-C30604FS/stmbl.conf
@timeout 120
vel_int0.mode = 1
vel_int0.sync = 1
vel_int0.wd = 0.003
lcnc 0 0
run 0.5
lcnc 1 0
run 1.5
lcnc 1 100
run 1
@sample pid0.pos_error 0.0002 0.5
lcnc_jitter 0 5 7
run 0.2
@sample pid0.pos_error 0.0002 0.5
lcnc_jitter 2 5 7
run 0.2
@sample pid0.pos_error 0.0002 0.5
fault0.fault
vel_int0.sync_lost
@expect fault0.fault == 0
@expect vel_int0.sync_lost > 10
@expect max|pid0.pos_error[1:2500]| < 0.002
@expect max|pid0.pos_error[2501:5000]| < 0.004
@expect max|pid0.pos_error[5001:7500]| < 0.006
