# Index homing a second time (index_rehome.test), the joint creeping on
# from where the first left it: the index is found, the feedback continues
# without a jump and the drive follows the moved command.
@args --drive ../hwtest/burnin/ECMA-C30604FS/stmbl.conf
@timeout 120
lcnc 0 0
run 0.5
lcnc 1 0
run 1.5
lcnc 1 20
run 0.5
lcncindex 1
run 2.5
lcnc 1 0
run 0.5
lcncindex 1
run 0.5
lcnc 1 20
run 1.0
lcncindex
@expect lcncindex.found == 1
@expect lcncindex.periods > 500
@expect lcncindex.ferr < 0.05
# 0.0054 here: 5 counts and the 20 units/s of a period's latency
@expect lcncindex.jump < 0.01
