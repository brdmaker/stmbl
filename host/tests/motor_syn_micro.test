# GENERATED by tests/gen_motor_tests.py -- edit the table there.
# rlpsij autotune on motor syn_micro: r 15, l 0.004, psi 0.015,
# polecount 4, j 4e-07, test_cur 0.3 (30% of max_ac_cur 1).
@args --drive ../hwtest/burnin/ECMA-C30604FS/stmbl.conf
conf0.r = 15
conf0.l = 0.004
conf0.psi = 0.015
conf0.polecount = 4
conf0.j = 4e-07
conf0.f = 0.0018
conf0.d = 2.52e-06
conf0.max_ac_cur = 1
@include tests/inc/rlpsij_hv0.txt
rlpsij0.test_cur = 0.3
rlpsij0.abs_pos_fb = hv0.sim_pos
# j and l x 1e6, so the 6-decimal console keeps their digits
load scale
load scale
scale0.rt_prio = 15
scale0.scale = 1000000
scale0.in0 = rlpsij0.j
scale1.rt_prio = 15
scale1.scale = 1000000
scale1.in0 = rlpsij0.l
relink
start
debug_level 0
fault0.cmd_error = 0
rlpsij0.en = 1
@sample hv0.sim_vel 0.002 18
rlpsij0.state
rlpsij0.r
rlpsij0.psi
rlpsij0.polecount
rlpsij0.friction
rlpsij0.damping
rlpsij0.load
scale0.out0
scale1.out0
@expect rlpsij0.state == 6
@expect rlpsij0.r ~ 15 3%
@expect rlpsij0.polecount == 4
@expect rlpsij0.psi ~ 0.015 5%
@expect scale0.out0 ~ 0.4 10%
@expect rlpsij0.friction ~ 0.0018 15%
# l not checked: l / r = 267 us < 500 us
@expect max|hv0.sim_vel| < 80
