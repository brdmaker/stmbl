# The capture scope over the smart-serial console: set up, armed and
# downloaded through 'con' (the simulated LinuxCNC end), as servoterm-cli
# does over sserialterm's pty: 1024 samples x 4 channels, ~15 kB with the framing, at a byte
# a millisecond.
@args --drive ../hwtest/burnin/ECMA-C30604FS/stmbl.conf
@timeout 300
lcnc 0 0
run 0.5
lcnc 1 0
run 1.5
con scope0.ch0 = hv0.iq_fb
con scope0.ch1 = hv0.sim_vel
con scope0.ch2 = hv0.id_fb
con scope0.ch3 = pe0.p_in
con scope0.trig = hv0.sim_vel
con scope0.level = 10
con scopearm
run 0.5
lcnc 1 31.4
run 1
con scopedump
run 20
conread
@match ^con> scope: armed
@match ^con> scope begin nch=4 n=1024 dt=0.0002 pre=102$
@match ^con> scope ch3 pe0.p_in min=
@match ^con> scope end lines=171$
