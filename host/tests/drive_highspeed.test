# Top speed on the simulated drive: festo (r 9.6, pp 4) to 288 rad/s at
# 3000 rad/s^2 and back, both directions, with back-EMF feedforward
# (conf0.cur_ind = 1). Regression test for conf/template/pid.txt's
# vel2.g = conf0.polecount: vel2 observes the electrical angle, and with
# the old g = 1 its torque feedforward was polecount x too small; its speed
# (hv0.vel, which the current loop's feedforward uses) was off by up to
# 1100 rad/s and the motor ran away to ~560 rad/s (ferror 0.82 rad).
@args --drive ../hwtest/burnin/ECMA-C30604FS/stmbl.conf
conf0.r = 9.6
conf0.l = 0.01
conf0.psi = 0.05
conf0.polecount = 4
conf0.j = 0.000026
conf0.f = 0.06
conf0.d = 8.4e-05
conf0.max_ac_cur = 10
conf0.max_force = 3
conf0.max_vel = 320
conf0.cur_ind = 1
debug_level 0
lcnc 0 0
run 0.5
lcnc 1 0
run 1.5
lcnc 1 19.0986
run 0.004
hv0.sim_vel
pid0.pos_error
lcnc 1 38.1972
run 0.004
