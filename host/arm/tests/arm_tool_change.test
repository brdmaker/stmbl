# The pneumatic tool changer (arcmate_changer.arm, tools.txt): tool 2 (the
# gripper) and tool 1 (a bent-neck torch: TCP 40 mm off the axis, tilted
# 20 deg) picked from their docks and put back, collision detector and
# prevention (10 mm, the mounted tool's bodies) on. The changer's monitor
# (shared/robot/tool.h) sees each tool locked and identified; the plant
# carries its mass, the detector's model gets it (no false hit). With the
# torch on, Cartesian moves run on its TCP: a reorientation about the TCP
# keeps the tip in place while the flange swings.
@program arm/arm_sim
@args arm/arcmate/arcmate_changer.arm
detector arm/arcmate/model_perturbed.arm
lcnc 0
run 0.5
lcnc 1
run 1.5
mark
prevent 10
@include arm/tests/inc_tool_pick2.txt
print tool
lmove 2 1150 0 1100 0 45 0
run 2.2
print pose tool
@include arm/tests/inc_tool_drop2.txt
print tool
@include arm/tests/inc_tool_pick1.txt
lmove 2 1150 0 1150 0 45 0
run 2.2
print pose
lmove 2 1150 0 1150 15 30 10
run 2.2
print pose
ktool 0
print pose
ktool 1
@include arm/tests/inc_tool_drop1.txt
print tool coll off hits
@expect arm.tool_mounted[1] == 2
@expect arm.tool_plant[1] == 2
@expect arm.tool_id[1] == 2
@expect arm.tool_state2[1] == 1
@expect arm.pose_x[1] ~ 1150 0.2
@expect arm.pose_z[1] ~ 1100 0.2
@expect arm.tool_mounted[2] == 2
@expect arm.tool_mounted[3] == 0
@expect arm.tool_state2[3] == 0
@expect arm.tool_unlocked[3] == 1
@expect arm.pose_x[2] ~ 1150 0.2
@expect arm.pose_y[2] ~ 0 0.2
@expect arm.pose_z[2] ~ 1150 0.2
@expect arm.pose_b[2] ~ 45 0.05
@expect arm.pose_x[3] ~ 1150 0.2
@expect arm.pose_y[3] ~ 0 0.2
@expect arm.pose_z[3] ~ 1150 0.2
@expect arm.pose_a[3] ~ 15 0.05
@expect arm.pose_b[3] ~ 30 0.05
@expect arm.pose_c[3] ~ 10 0.05
@expect arm.pose_x[4] < 1000
@expect arm.tool_mounted[-1] == 0
@expect arm.tool_state1[-1] == 0
@expect arm.tool_fault == 0
@expect arm.coll == 0
@expect arm.off_reason == 0
@expect max arm.hits2 == 0
@reject ^ERROR
